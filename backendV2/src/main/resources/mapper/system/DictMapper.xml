<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jzsk.backendv2.mapper.system.DictMapper">

    <resultMap id="BaseResultMap" type="com.jzsk.backendv2.pojo.entity.system.DictEntity">
        <id column="dict_id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <resultMap id="DictResultMap" type="com.jzsk.backendv2.pojo.entity.system.DictEntity">
        <id column="dict_id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <collection property="dictDetails" ofType="com.jzsk.backendv2.pojo.entity.system.DictDetailEntity">
            <id column="detail_id" property="id"/>
            <result column="detail_dict_id" property="dictId"/>
            <result column="detail_label" property="label"/>
            <result column="detail_value" property="value"/>
            <result column="detail_dict_sort" property="dictSort"/>
            <result column="detail_create_time" property="createTime"/>
            <result column="detail_update_time" property="updateTime"/>
        </collection>
    </resultMap>

    <sql id="DictColumns">
        d.dict_id,
        d.name,
        d.description,
        d.create_time,
        d.update_time
    </sql>

    <sql id="DetailColumns">
        dd.detail_id as detail_id,
        dd.dict_id as detail_dict_id,
        dd.label as detail_label,
        dd.value as detail_value,
        dd.dict_sort as detail_dict_sort,
        dd.create_time as detail_create_time,
        dd.update_time as detail_update_time
    </sql>

    <sql id="WhereClause">
        <where>
            <if test="query != null and query.blurry != null and query.blurry != ''">
                AND d.name LIKE CONCAT('%', #{query.blurry}, '%')
            </if>
        </where>
    </sql>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT
            <include refid="DictColumns"/>
        FROM dict d
        <include refid="WhereClause"/>
        ORDER BY d.dict_id ASC
        LIMIT #{offset}, #{size}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*)
        FROM dict d
        <include refid="WhereClause"/>
    </select>

    <select id="selectBaseById" resultMap="BaseResultMap">
        SELECT
            <include refid="DictColumns"/>
        FROM dict d
        WHERE d.dict_id = #{id}
    </select>

    <select id="selectById" resultMap="DictResultMap">
        SELECT
            <include refid="DictColumns"/>,
            <include refid="DetailColumns"/>
        FROM dict d
        LEFT JOIN dict_detail dd ON d.dict_id = dd.dict_id
        WHERE d.dict_id = #{id}
        ORDER BY dd.dict_sort ASC, dd.detail_id ASC
    </select>

    <select id="countByName" resultType="int">
        SELECT COUNT(*)
        FROM dict
        WHERE name = #{name}
        <if test="excludeId != null">
            AND dict_id != #{excludeId}
        </if>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dict (
            name,
            description,
            create_time,
            update_time
        ) VALUES (
            #{name},
            #{description},
            NOW(),
            NOW()
        )
    </insert>

    <update id="update">
        UPDATE dict
        SET
            name = #{name},
            description = #{description},
            update_time = NOW()
        WHERE dict_id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM dict
        WHERE dict_id = #{id}
    </delete>

    <select id="selectOptionsByName" resultType="com.jzsk.backendv2.pojo.vo.OptionVO">
        SELECT
            dd.label as label,
            dd.value as value
        FROM dict d
        INNER JOIN dict_detail dd ON d.dict_id = dd.dict_id
        WHERE d.name = #{name}
        ORDER BY dd.dict_sort ASC, dd.detail_id ASC
    </select>

    <select id="selectDetailCounts" resultType="java.util.Map">
        SELECT dict_id as dictId, COUNT(*) as detailCount
        FROM dict_detail
        WHERE dict_id IN
        <foreach collection="dictIds" item="dictId" open="(" separator="," close=")">
            #{dictId}
        </foreach>
        GROUP BY dict_id
    </select>
</mapper>
