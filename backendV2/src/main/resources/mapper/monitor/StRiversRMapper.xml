<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jzsk.backendv2.mapper.monitor.StRiversRMapper">

    <resultMap id="BaseResultMap" type="com.jzsk.backendv2.pojo.entity.monitor.StRiversREntity">
        <id column="STCD" property="stcd"/>
        <result column="TM" property="tm"/>
        <result column="Z1" property="z1"/>
        <result column="Q1" property="q1"/>
    </resultMap>

    <select id="selectLatestByStcd" resultMap="BaseResultMap">
        SELECT TOP 1 STCD, TM, Z1, Q1
        FROM ST_RIVER_R
        WHERE STCD = #{stcd}
        ORDER BY TM DESC
    </select>

    <!-- 统计水位数据总数（SQL Server语法） -->
    <select id="countPage" resultType="long">
        SELECT COUNT(*)
        FROM ST_RIVER_R
        <where>
            <if test="stcd != null and stcd != ''">
                AND STCD = #{stcd}
            </if>
        </where>
    </select>

    <!-- 查询所有水位数据（SQL Server语法） -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT STCD, TM, Z1, Q1
        FROM ST_RIVER_R
        ORDER BY TM DESC
    </select>

    <!-- 根据测站编码查询水位数据（SQL Server语法） -->
    <select id="selectByStcd" resultMap="BaseResultMap">
        SELECT STCD, TM, Z1, Q1
        FROM ST_RIVER_R
        <where>
            <if test="stcd != null and stcd != ''">
                AND STCD = #{stcd}
            </if>
        </where>
        ORDER BY TM DESC
    </select>

    <!-- 根据时间范围查询水位数据（SQL Server语法） -->
    <select id="selectByTimeRange" resultMap="BaseResultMap">
        SELECT STCD, TM, Z1, Q1
        FROM ST_RIVER_R
        <where>
            <if test="startDate != null">
                AND TM &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                AND TM &lt;= #{endDate}
            </if>
        </where>
        ORDER BY TM DESC
    </select>

    <!-- 分页查询水位数据（SQL Server语法） -->
    <select id="selectPage" resultMap="BaseResultMap">
        SELECT STCD, TM, Z1, Q1
        FROM ST_RIVER_R
        <where>
            <if test="stcd != null and stcd != ''">
                AND STCD = #{stcd}
            </if>
        </where>
        ORDER BY TM DESC
        OFFSET #{offset} ROWS FETCH NEXT #{size} ROWS ONLY
    </select>

</mapper>
