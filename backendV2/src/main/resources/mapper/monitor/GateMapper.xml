    <!-- 东干渠(DGQ)查询（分页） -->
    <select id="selectDgq" resultMap="DgqResultMap">
        SELECT TM, DGQ_M1_IA, DGQ_M1_IB, DGQ_M1_IC, DGQ_M1_UA, DGQ_M1_UB, DGQ_M1_UC,
               DGQ_M1_UAB, DGQ_M1_UBC, DGQ_M1_UCA, DGQ_M1_KD, DGQ_M1_KDSD
        FROM DGQ
        <where>
            <if test="startTime != null and startTime != ''">
                AND TM &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND TM &lt;= #{endTime}
            </if>
        </where>
        ORDER BY TM DESC
        OFFSET #{offset} ROWS FETCH NEXT #{size} ROWS ONLY
    </select>

    <!-- 东干渠(DGQ)总数 -->
    <select id="countDgq" resultType="long">
        SELECT COUNT(*)
