<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szy.mapper.DeptMapper">

    <resultMap id="BaseResultMap" type="com.szy.pojo.entity.Department">
        <id column="id" property="id"/>
        <result column="department_name" property="departmentName"/>
        <result column="department_responsibility" property="departmentResponsibility"/>
        <result column="level" property="level"/>
        <result column="company" property="company"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, department_name, department_responsibility, level, company, create_time, update_time
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM department
        <where>
            <if test="departmentName != null and departmentName != ''">
                AND department_name LIKE CONCAT('%', #{departmentName}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM department
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.szy.pojo.entity.Department" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO department (department_name, department_responsibility, level, company)
        VALUES (#{departmentName}, #{departmentResponsibility}, #{level}, #{company})
    </insert>

    <update id="update" parameterType="com.szy.pojo.entity.Department">
        UPDATE department
        SET department_name = #{departmentName},
            department_responsibility = #{departmentResponsibility},
            level = #{level},
            company = #{company}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM department WHERE id = #{id}
    </delete>

</mapper>
