<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szy.mapper.PersonMapper">

    <resultMap id="BaseResultMap" type="com.szy.pojo.entity.Person">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
        <result column="gender" property="gender"/>
        <result column="phone" property="phone"/>
        <result column="organization" property="organization"/>
        <result column="position" property="position"/>
        <result column="duty" property="duty"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, age, gender, phone, organization, position, duty, create_time, update_time
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM person
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM person
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.szy.pojo.entity.Person" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO person (name, age, gender, phone, organization, position, duty)
        VALUES (#{name}, #{age}, #{gender}, #{phone}, #{organization}, #{position}, #{duty})
    </insert>

    <update id="update" parameterType="com.szy.pojo.entity.Person">
        UPDATE person
        SET name = #{name},
            age = #{age},
            gender = #{gender},
            phone = #{phone},
            organization = #{organization},
            position = #{position},
            duty = #{duty}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM person WHERE id = #{id}
    </delete>

</mapper>
