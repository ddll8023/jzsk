<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szy.mapper.MeasuringItemMapper">
    <insert id="add">
        insert into measuring_item (
            number,
            name,
            unit,
            create_time,
            update_time
        ) values (
            #{number},
            #{name},
            #{unit},
            #{createTime},
            #{updateTime}
        )
    </insert>
</mapper>