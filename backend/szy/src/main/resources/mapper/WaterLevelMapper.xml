<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szy.mapper.WaterLevelMapper">
    <select id="getValuesByMap" resultType="java.lang.Double" parameterType="java.util.Map">
        select value from water_level
        <where>
            <if test="startTime != null">
                and monitor_time &gt; #{startTime}
            </if>
            <if test="endTime != null">
                and monitor_time &lt; #{endTime}
            </if>
            <if test="position != null">
                and position = #{position}
            </if>
        </where>
    </select>
    <select id="getTimesByMap" resultType="cn.hutool.core.date.DateTime" parameterType="java.util.Map">
        select monitor_time from water_level
        <where>
            <if test="startTime != null">
                and monitor_time &gt; #{startTime}
            </if>
            <if test="endTime != null">
                and monitor_time &lt; #{endTime}
            </if>
            <if test="position != null">
                and position = #{position}
            </if>
        </where>
    </select>
</mapper>
